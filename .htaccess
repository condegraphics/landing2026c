Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Canonicaliza index.html, HTTP y el host sin www en una sola URL pública.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ https://www.condegraphics.com/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} !^www\.condegraphics\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.condegraphics.com%{REQUEST_URI} [R=301,L,NE]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
